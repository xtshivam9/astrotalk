{
  "expo": {
    "name": "Astrotalk",
    "slug": "astrotalk-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astrotalk.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.astrotalk.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "astrotalk",
    "plugins": [
      [
        "expo-linking",
        {
          "scheme": "astrotalk"
        }
      ]
    ]
  }
}
